  "workflow": {
    "roles": [
      {
        "id": 0,
        "name": "Inspector",
        "public": true
      },
      {
        "id": 1,
        "name": "Form Creator / Internal Reviewer",
        "internal": true
      }
    ],
    "statuses": [
      {
        "id": 0,
        "name": "Incomplete",
        "color": "gray"
      },
      {
        "id": 1,
        "name": "Submitted",
        "color": "teal"
      },
      {
        "id": 2,
        "name": "Reviewed",
        "color": "yellow"
      },
      {
        "id": 3,
        "name": "Approved",
        "color": "green"
      }
    ],
    "actions": [
      {
        "id": 0,
        "name": "SubmitInspection",
        "button": "SubmitInspection",
        "allowedWhen": "status == 'Incomplete' AND role == 'Inspector'",
        "newStatus": "Submitted",
        "confirmation": "Thank you for filling out the form. Your response has been recorded.",
        "emails": [
          {
            "from": "sales@fueltrailers.co.za",
            "to": [
              "sales@fueltrailers.co.za"
            ],
            "subject": "Trailer Inspection Submitted",
            "body": "An inspector has submitted the Trailer Inspection Checklist. Please review the inspection results.",
            "includeEntryDetails": true,
            "linkForRole": "Form Creator / Internal Reviewer"
          }
        ]
      },
      {
        "id": 1,
        "name": "RequestReviewChanges",
        "button": "RequestReviewChanges",
        "allowedWhen": "status == 'Submitted' AND role == 'Form Creator / Internal Reviewer'",
        "newStatus": "Submitted",
        "confirmation": "Thank you for filling out the form. Your response has been recorded.",
        "note": "Cognito keeps status at Submitted (probably intended to go back to Incomplete so the Inspector can edit - confirm with client)",
        "emails": [
          {
            "from": "sales@fueltrailers.co.za",
            "to": [
              "[InspectorEmail]"
            ],
            "subject": "Trailer Inspection Needs Changes",
            "body": "Your Trailer Inspection Checklist submission requires changes. Please update the inspection details and resubmit.",
            "includeEntryDetails": true,
            "linkForRole": "Inspector"
          }
        ]
      },
      {
        "id": 2,
        "name": "MarkReviewed",
        "button": "MarkReviewed",
        "allowedWhen": "status == 'Submitted' AND role == 'Form Creator / Internal Reviewer'",
        "newStatus": "Reviewed",
        "confirmation": "Thank you for filling out the form. Your response has been recorded.",
        "emails": [
          {
            "from": "sales@fueltrailers.co.za",
            "to": [
              "[InspectorEmail]"
            ],
            "subject": "Trailer Inspection Reviewed",
            "body": "Your Trailer Inspection Checklist has been reviewed.",
            "includeEntryDetails": true,
            "linkForRole": "Inspector"
          }
        ]
      },
      {
        "id": 3,
        "name": "ApproveInspection",
        "button": "ApproveInspection",
        "allowedWhen": "status == 'Reviewed' AND role == 'Form Creator / Internal Reviewer'",
        "newStatus": "Approved",
        "confirmation": "Thank you for filling out the form. Your response has been recorded.",
        "emails": [
          {
            "from": "sales@fueltrailers.co.za",
            "to": [
              "[InspectorEmail]"
            ],
            "subject": "Trailer Inspection Approved",
            "body": "Your Trailer Inspection Checklist has been approved.",
            "includeEntryDetails": true,
            "linkForRole": "Inspector"
          }
        ]
      }
    ]
  },
