# Copy to .env.local for local development. Never commit real values.
# Variables marked (later) are used by phases after M0 and can stay empty for now.

# Supabase (M0)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, bypasses RLS

# App (M0)
APP_URL=http://localhost:3000   # production: the public https URL. Invite emails and copied invite links are built from it
SENTRY_DSN=                         # optional; Sentry stays off when empty
NEXT_PUBLIC_SENTRY_DSN=

# Forms engine (M1)
ENTRY_ENCRYPTION_KEY=               # required: 32-byte base64; encrypts DEAL and Delivery Note entries. Losing it loses them.
PUBLIC_ORG_ID=                      # optional: org that owns the public /f/<slug> links (defaults to the seeded org)
RESEND_API_KEY=                     # optional: without it emails are logged as 'skipped' in email_log, not sent
MAIL_FROM=                          # e.g. "Fuel Trailers <sales@fueltrailers.co.za>" (verified Resend domain)

# Used only by `pnpm create-admin` (pass on the command line, do not store here)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=                   # at least 12 characters
# ADMIN_NAME=
# ORG_ID=                           # only needed if there is more than one org

# Tests (not a real project; any local Postgres 15+ superuser)
# DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres

# Jobs and secret encryption (M2)
JOB_SECRET=                         # at least 32 chars; bearer secret for /api/jobs/* (also stored in Supabase Vault, see supabase/scheduler.sql)
ENCRYPTION_KEY=                     # 32-byte base64; encrypts Xero tokens. Losing it means reconnecting Xero.

# Xero (M2: read-only mirror)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=                  # optional; default <APP_URL>/admin/integrations/xero/callback
XERO_WEBHOOK_KEY=
XERO_TENANT_ID=                     # optional; pick one organisation when the login sees several
XERO_BACKFILL_FROM=                 # optional; default 2025-01-01
XERO_SCOPES=                        # optional; default read-only scopes

# (later) Cognito history import only; remove after cutover
COGNITO_API_KEY=

# Leads (M4)
LEADS_WEBHOOK_SECRET=               # shared secret for POST /api/webhooks/leads (header x-leads-secret); at least 32 chars, e.g. `openssl rand -hex 32`. Empty: intake refuses every post (503)

# (later) Public form protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
